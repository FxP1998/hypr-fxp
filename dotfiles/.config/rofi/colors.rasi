* {
    /* --- STANDARD MATERIAL PALETTE --- */
    primary: #d2bbff;
    on-primary: #3b1d71;
    primary-container: #523689;
    on-primary-container: #eaddff;

    secondary: #cdc2db;
    on-secondary: #342d40;
    secondary-container: #4b4358;
    on-secondary-container: #e9def8;

    tertiary: #f0b7c5;
    on-tertiary: #4a2530;
    tertiary-container: #643b46;
    on-tertiary-container: #ffd9e1;

    error: #ffb4ab;
    on-error: #690005;
    
    surface: #131313;
    on-surface: #e2e2e2;
    on-surface-variant: #c6c6c6;

    outline: #919191;
    outline-variant: #474747;

    surface-container: #1f1f1f;
    surface-container-high: #2a2a2a;
    surface-container-highest: #353535;

    /* --- SEMANTIC ALIASES --- */

    /* Main Background (Solid) */
    background-col: #131313;

    /* Main Background (Transparent) - 80% Opacity */
    background-alpha-col: #131313CC;

    /* Card/Element Background */
    background-alt-col: #1f1f1f;

    /* Text */
    foreground-col: #e2e2e2;

    /* Highlights */
    selected-col: #d2bbff;
    active-col: #cdc2db;
    urgent-col: #ffb4ab;
}
