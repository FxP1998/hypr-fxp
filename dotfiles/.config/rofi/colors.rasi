* {
    /* --- STANDARD MATERIAL PALETTE --- */
    primary: #bcc2ff;
    on-primary: #1b2678;
    primary-container: #343f90;
    on-primary-container: #dfe0ff;

    secondary: #c4c5dd;
    on-secondary: #2d2f42;
    secondary-container: #444559;
    on-secondary-container: #e0e0f9;

    tertiary: #e6bad6;
    on-tertiary: #45263d;
    tertiary-container: #5e3c54;
    on-tertiary-container: #ffd7f0;

    error: #ffb4ab;
    on-error: #690005;
    
    surface: #131313;
    on-surface: #e2e2e2;
    on-surface-variant: #c6c6c6;

    outline: #919191;
    outline-variant: #474747;

    surface-container: #1f1f1f;
    surface-container-high: #2a2a2a;
    surface-container-highest: #353535;

    /* --- SEMANTIC ALIASES --- */

    /* Main Background (Solid) */
    background-col: #131313;

    /* Main Background (Transparent) - 80% Opacity */
    background-alpha-col: #131313CC;

    /* Card/Element Background */
    background-alt-col: #1f1f1f;

    /* Text */
    foreground-col: #e2e2e2;

    /* Highlights */
    selected-col: #bcc2ff;
    active-col: #c4c5dd;
    urgent-col: #ffb4ab;
}
