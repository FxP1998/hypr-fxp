* {
    /* --- STANDARD MATERIAL PALETTE --- */
    primary: #80d997;
    on-primary: #00391a;
    primary-container: #005228;
    on-primary-container: #9cf6b2;

    secondary: #b7ccb7;
    on-secondary: #223526;
    secondary-container: #394b3c;
    on-secondary-container: #d2e8d3;

    tertiary: #a2ced9;
    on-tertiary: #01363f;
    tertiary-container: #204d56;
    on-tertiary-container: #bdeaf5;

    error: #ffb4ab;
    on-error: #690005;
    
    surface: #131313;
    on-surface: #e2e2e2;
    on-surface-variant: #c6c6c6;

    outline: #919191;
    outline-variant: #474747;

    surface-container: #1f1f1f;
    surface-container-high: #2a2a2a;
    surface-container-highest: #353535;

    /* --- SEMANTIC ALIASES --- */

    /* Main Background (Solid) */
    background-col: #131313;

    /* Main Background (Transparent) - 80% Opacity */
    background-alpha-col: #131313CC;

    /* Card/Element Background */
    background-alt-col: #1f1f1f;

    /* Text */
    foreground-col: #e2e2e2;

    /* Highlights */
    selected-col: #80d997;
    active-col: #b7ccb7;
    urgent-col: #ffb4ab;
}
