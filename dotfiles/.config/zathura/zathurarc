# -----------------------------------------------------------------------------
#  󰣇  ZATHURA CONFIGURATION (Matugen Generated)
#  󰁔  Description: Dynamic PDF/Document viewer styling.
# -----------------------------------------------------------------------------

# --- UI SETTINGS ---
set selection-clipboard clipboard
set window-title-basename true
set statusbar-basename true
set guioptions none

# --- SCROLLING & ZOOM ---
set scroll-step 50
set zoom-step 10

# --- COLORS (Generated by Matugen) ---
set default-bg                  "#131313"
set default-fg                  "#e2e2e2"

set statusbar-bg                "#1f1f1f"
set statusbar-fg                "#e2e2e2"

set inputbar-bg                 "#2a2a2a"
set inputbar-fg                 "#ffb3b4"

set notification-bg             "#ffb3b4"
set notification-fg             "#5f131c"

set notification-error-bg       "#ffb4ab"
set notification-error-fg       "#690005"

set notification-warning-bg     "#e5c18d"
set notification-warning-fg     "#422c05"

# Selection highlight (Standard Hex for compatibility)
set highlight-color             "#ffb3b4"
set highlight-active-color      "#e6bdbc"

set completion-bg               "#1f1f1f"
set completion-fg               "#e2e2e2"

set completion-highlight-bg     "#ffb3b4"
set completion-highlight-fg     "#5f131c"

set index-bg                    "#131313"
set index-fg                    "#e2e2e2"

set index-active-bg             "#ffb3b4"
set index-active-fg             "#5f131c"

set render-loading-bg           "#131313"
set render-loading-fg           "#e2e2e2"

# --- RECOLOR SETTINGS (Dark Mode) ---
set recolor                     "true"
set recolor-lightcolor          "#131313"
set recolor-darkcolor           "#e2e2e2"
set recolor-keephue             "false"
