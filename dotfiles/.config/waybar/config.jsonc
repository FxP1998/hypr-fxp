{
  "layer": "top",
  "position": "left",
  "width": 50, // Back to your original width
  "margin-top": 5,
  "margin-bottom": 5,
  "margin-left": 5,
  "margin-right": 0,

  // --- MODULE LAYOUT ---
  "modules-left": [
    "clock",
    "group/misc",
    "custom/screen-recording",
    "custom/updates",
    "custom/rice"
  ],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "custom/separator",
    "group/volume",
    "group/brightness",
    "battery",
    "custom/launcher",
  ],

  // --- MODULE CONFIGURATION ---

  "clock": {
    // Original bold formatting
    "format": "{:%I\n%M\n%p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "<b>{}</b>",
        "weeks": "<b>W{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
    },
  },

  "group/misc": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": ["custom/separator", "custom/power", "custom/separator", "tray"],
  },

  "custom/separator": {
    "format": "━━━", // Original thicker separator
    "tooltip": false,
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10,
    "tooltip": false,
  },

  "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -b 2"
    },

  "custom/screen-recording": {
    "format": " 󰑊 ",
    "return-type": "json",
    "exec-if": "pgrep wf-recorder",
    "exec": "echo '{\"class\": \"recording-active\"}'",
    "interval": 1,
    "tooltip": false,
  },

  "custom/updates": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/waybar/updater/check_updates.sh",
    "return-type": "json",
    "interval": 3600,
    "tooltip": true,
    "on-click": "kitty -T 'System Update' ~/.config/hypr/scripts/waybar/updater/run_update.sh",
    "signal": 8,
  },

  // ORIGINAL WORKSPACE CONFIGURATION
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "active": "",
      "default": "",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },

  "group/volume": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "vertical",
    "width": 8, // Original narrow width
    "reverse": false,
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": ["", "", ""],
      "speaker": ["", "", ""],
      "default": ["", "", ""],
    },
    "scroll-step": 5,
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip-format": " 󰕾 {volume}% ",
    "tooltip": true,
  },

  "group/brightness": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": ["backlight", "backlight/slider"],
  },

  "backlight/slider": {
    "min": 10,
    "max": 100,
    "orientation": "vertical",
    "width": 8,
    "reverse": false,
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": {
      "default": ["󰃞", "󰃟", "󰃠"],
    },
    "interval": 2,
    "on-scroll-up": "swayosd-client --brightness raise",
    "on-scroll-down": "swayosd-client --brightness lower",
    "tooltip": false,
  },

  "battery": {
    "format": "{icon}",
    "format-full": "󱈏",
    "format-charging": " \n{capacity}%", // Original multi-line charging format
    "format-discharging": "{icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "critical": 15,
      "warning": 30,
    },
    "tooltip-format": " {capacity}% ",
  },

  "custom/rice": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/waybar/updater/check_repo_updates.sh",
    "return-type": "json",
    "interval": 3600,
    "tooltip": true,
    "on-click": "kitty -T 'Rice Update' ~/FxP1998/update.sh",
    "signal": 10,
  },

  "custom/launcher": {
    "format": "󰘳",
    "on-click": "~/.config/hypr/scripts/rofi/rofi-launcher.sh",
    "on-click-right": "~/.config/hypr/scripts/rofi/keybinds.sh",
    "tooltip": true,
    "tooltip-format": " Launcher ",
  },
}
