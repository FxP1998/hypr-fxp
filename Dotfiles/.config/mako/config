# -----------------------------------------------------------------------------
# MAKO CONFIGURATION (Matugen Template)
# -----------------------------------------------------------------------------

# --- Colors (Generated by Matugen) ---
background-color=#0f1416D9
text-color=#dee3e6
border-color=#85d1e8
progress-color=source #85d1e8

# --- Typography ---
font=MapleMono NF Mono 12

# --- Window Geometry ---
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=15

# --- Positioning ---
anchor=top-right

# --- Behavior ---
default-timeout=5000
ignore-timeout=1
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1

# --- Grouping ---
group-by=app-name

# --- Urgency Styles ---
[urgency=low]
border-color=#b2cbd3
text-color=#bfc8cb

[urgency=normal]
border-color=#85d1e8

[urgency=critical]
border-color=#ffb4ab
text-color=#ffb4ab
default-timeout=0
