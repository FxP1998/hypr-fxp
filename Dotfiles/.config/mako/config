# -----------------------------------------------------------------------------
# MAKO CONFIGURATION (Matugen Template)
# -----------------------------------------------------------------------------

# --- Colors (Generated by Matugen) ---
background-color=#131318D9
text-color=#e4e1e9
border-color=#c0c1ff
progress-color=source #c0c1ff

# --- Typography ---
font=MapleMono NF Mono 12

# --- Window Geometry ---
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=15

# --- Positioning ---
anchor=top-right

# --- Behavior ---
default-timeout=5000
ignore-timeout=1
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1

# --- Grouping ---
group-by=app-name

# --- Urgency Styles ---
[urgency=low]
border-color=#c5c4dd
text-color=#c7c5d0

[urgency=normal]
border-color=#c0c1ff

[urgency=critical]
border-color=#ffb4ab
text-color=#ffb4ab
default-timeout=0
