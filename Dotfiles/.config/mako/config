# -----------------------------------------------------------------------------
# MAKO CONFIGURATION (Matugen Template)
# -----------------------------------------------------------------------------

# --- Colors (Generated by Matugen) ---
background-color=#101418D9
text-color=#e0e2e8
border-color=#9ccbfb
progress-color=source #9ccbfb

# --- Typography ---
font=MapleMono NF Mono 12

# --- Window Geometry ---
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=15

# --- Positioning ---
anchor=top-right

# --- Behavior ---
default-timeout=5000
ignore-timeout=1
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1

# --- Grouping ---
group-by=app-name

# --- Urgency Styles ---
[urgency=low]
border-color=#b9c8da
text-color=#c2c7cf

[urgency=normal]
border-color=#9ccbfb

[urgency=critical]
border-color=#ffb4ab
text-color=#ffb4ab
default-timeout=0
