/* -----------------------------------------------------------------------------
 * ROFI THEME - FxP Spotlight (Transparent)
 * ----------------------------------------------------------------------------- */

@import "colors.rasi"

* {
    /* Global Properties */
    background-color:            transparent;
    text-color:                  @foreground-col;
    margin:                      0px;
    padding:                     0px;
}

/* --- MAIN WINDOW --- */
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       750px;

    enabled:                     true;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @selected-col;
    cursor:                      "default";

    /* USE THE TRANSPARENT COLOR HERE */
    background-color:            @background-alpha-col;
}

/* --- MAIN CONTAINER --- */
mainbox {
    enabled:                     true;
    spacing:                     20px;
    padding:                     40px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/* --- INPUT BAR --- */
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               15px;
    background-color:            @background-alt-col;
    text-color:                  @foreground-col;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  @selected-col;
    padding:                     0px 10px 0px 5px;
    font:                        "MapleMono NF Mono 16";
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  @foreground-col;
    cursor:                      text;
    placeholder:                 "Search Apps...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/* --- LIST VIEW --- */
listview {
    enabled:                     true;
    columns:                     2;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     10px;
    background-color:            transparent;
    cursor:                      "default";
}

/* --- ELEMENTS --- */
element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     12px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @foreground-col;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground-col;
}

element selected.normal {
    background-color:            @background-alt-col;
    text-color:                  @selected-col;
    border:                      1px solid;
    border-color:                @selected-col;
}

element normal.urgent {
    text-color:                  @urgent-col;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
