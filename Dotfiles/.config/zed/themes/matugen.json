{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Matugen Dark",
  "author": "FxP",
  "themes": [
    {
      "name": "Matugen Dark",
      "appearance": "dark",
      "style": {
        "border": "#8c9199",
        "border.variant": "#42474e",
        "border.focused": "#9ccbfb",
        "border.selected": "#9ccbfb",
        "border.transparent": null,
        "border.disabled": "#42474e",
        "elevated_surface.background": "#181c20",
        "surface.background": "#101418",
        "background": "#101418",
        "element.background": "#1c2024",
        "element.hover": "#272a2f",
        "element.active": "#323539",
        "element.selected": "#3a4857",
        "drop_target.background": "#323539",
        "ghost_element.background": null,
        "ghost_element.hover": "#272a2f",
        "ghost_element.active": "#323539",
        "ghost_element.selected": "#3a4857",
        "text": "#e0e2e8",
        "text.muted": "#c2c7cf",
        "text.placeholder": "#8c9199",
        "text.disabled": "#42474e",
        "text.accent": "#9ccbfb",
        "icon": "#c2c7cf",
        "icon.muted": "#8c9199",
        "icon.disabled": "#42474e",
        "icon.placeholder": "#42474e",
        "icon.accent": "#9ccbfb",
        "statusbar.background": "#1c2024",
        "titlebar.background": "#101418",
        "toolbar.background": "#101418",
        "tab_bar.background": "#181c20",
        "tab.inactive_background": "#181c20",
        "tab.active_background": "#101418",
        "search.background": "#272a2f",
        "panel.background": "#181c20",
        "scrollbar.thumb.background": "#42474e",
        "scrollbar.thumb.hover_background": "#8c9199",
        "scrollbar.track.background": "#101418",
        "scrollbar.track.border": "#42474e",
        "editor.background": "#101418",
        "editor.gutter.background": "#101418",
        "editor.subheader.background": "#1c2024",
        "editor.active_line.background": "#1c2024",
        "editor.highlighted_line.background": "#1c2024",
        "editor.line_number": "#42474e",
        "editor.active_line_number": "#9ccbfb",
        "editor.invisible": "#42474e",
        "editor.wrap_guide": "#42474e",
        "editor.active_wrap_guide": "#8c9199",
        "terminal.background": "#101418",
        "terminal.foreground": "#e0e2e8",
        "terminal.bright_foreground": "#e0e2e8",
        "terminal.dim_foreground": "#c2c7cf",
        "syntax": {
          "comment": { "color": "#8c9199", "font_style": "italic" },
          "keyword": { "color": "#d4bee6", "font_style": "normal" },
          "function": { "color": "#9ccbfb", "font_style": "normal" },
          "string": { "color": "#b9c8da", "font_style": "normal" },
          "type": { "color": "#d4bee6", "font_style": "normal" },
          "number": { "color": "#b9c8da", "font_style": "normal" },
          "property": { "color": "#e0e2e8", "font_style": "normal" },
          "operator": { "color": "#c2c7cf", "font_style": "normal" },
          "variable": { "color": "#e0e2e8", "font_style": "normal" },
          "constant": { "color": "#d4bee6", "font_style": "normal" }
        }
      }
    }
  ]
}
