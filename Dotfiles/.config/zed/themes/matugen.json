{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Matugen Dark",
  "author": "FxP",
  "themes": [
    {
      "name": "Matugen Dark",
      "appearance": "dark",
      "style": {
        "border": "#8a9296",
        "border.variant": "#40484c",
        "border.focused": "#88d1eb",
        "border.selected": "#88d1eb",
        "border.transparent": null,
        "border.disabled": "#40484c",
        "elevated_surface.background": "#171c1f",
        "surface.background": "#0f1416",
        "background": "#0f1416",
        "element.background": "#1b2023",
        "element.hover": "#252b2d",
        "element.active": "#303638",
        "element.selected": "#344a52",
        "drop_target.background": "#303638",
        "ghost_element.background": null,
        "ghost_element.hover": "#252b2d",
        "ghost_element.active": "#303638",
        "ghost_element.selected": "#344a52",
        "text": "#dee3e6",
        "text.muted": "#bfc8cc",
        "text.placeholder": "#8a9296",
        "text.disabled": "#40484c",
        "text.accent": "#88d1eb",
        "icon": "#bfc8cc",
        "icon.muted": "#8a9296",
        "icon.disabled": "#40484c",
        "icon.placeholder": "#40484c",
        "icon.accent": "#88d1eb",
        "statusbar.background": "#1b2023",
        "titlebar.background": "#0f1416",
        "toolbar.background": "#0f1416",
        "tab_bar.background": "#171c1f",
        "tab.inactive_background": "#171c1f",
        "tab.active_background": "#0f1416",
        "search.background": "#252b2d",
        "panel.background": "#171c1f",
        "scrollbar.thumb.background": "#40484c",
        "scrollbar.thumb.hover_background": "#8a9296",
        "scrollbar.track.background": "#0f1416",
        "scrollbar.track.border": "#40484c",
        "editor.background": "#0f1416",
        "editor.gutter.background": "#0f1416",
        "editor.subheader.background": "#1b2023",
        "editor.active_line.background": "#1b2023",
        "editor.highlighted_line.background": "#1b2023",
        "editor.line_number": "#40484c",
        "editor.active_line_number": "#88d1eb",
        "editor.invisible": "#40484c",
        "editor.wrap_guide": "#40484c",
        "editor.active_wrap_guide": "#8a9296",
        "terminal.background": "#0f1416",
        "terminal.foreground": "#dee3e6",
        "terminal.bright_foreground": "#dee3e6",
        "terminal.dim_foreground": "#bfc8cc",
        "syntax": {
          "comment": { "color": "#8a9296", "font_style": "italic" },
          "keyword": { "color": "#c3c3eb", "font_style": "normal" },
          "function": { "color": "#88d1eb", "font_style": "normal" },
          "string": { "color": "#b3cad4", "font_style": "normal" },
          "type": { "color": "#c3c3eb", "font_style": "normal" },
          "number": { "color": "#b3cad4", "font_style": "normal" },
          "property": { "color": "#dee3e6", "font_style": "normal" },
          "operator": { "color": "#bfc8cc", "font_style": "normal" },
          "variable": { "color": "#dee3e6", "font_style": "normal" },
          "constant": { "color": "#c3c3eb", "font_style": "normal" }
        }
      }
    }
  ]
}
