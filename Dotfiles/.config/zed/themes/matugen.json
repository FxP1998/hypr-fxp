{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Matugen Dark",
  "author": "FxP",
  "themes": [
    {
      "name": "Matugen Dark",
      "appearance": "dark",
      "style": {
        "border": "#918f9a",
        "border.variant": "#46464f",
        "border.focused": "#c0c1ff",
        "border.selected": "#c0c1ff",
        "border.transparent": null,
        "border.disabled": "#46464f",
        "elevated_surface.background": "#1b1b21",
        "surface.background": "#131318",
        "background": "#131318",
        "element.background": "#1f1f25",
        "element.hover": "#2a292f",
        "element.active": "#35343a",
        "element.selected": "#454559",
        "drop_target.background": "#35343a",
        "ghost_element.background": null,
        "ghost_element.hover": "#2a292f",
        "ghost_element.active": "#35343a",
        "ghost_element.selected": "#454559",
        "text": "#e4e1e9",
        "text.muted": "#c7c5d0",
        "text.placeholder": "#918f9a",
        "text.disabled": "#46464f",
        "text.accent": "#c0c1ff",
        "icon": "#c7c5d0",
        "icon.muted": "#918f9a",
        "icon.disabled": "#46464f",
        "icon.placeholder": "#46464f",
        "icon.accent": "#c0c1ff",
        "statusbar.background": "#1f1f25",
        "titlebar.background": "#131318",
        "toolbar.background": "#131318",
        "tab_bar.background": "#1b1b21",
        "tab.inactive_background": "#1b1b21",
        "tab.active_background": "#131318",
        "search.background": "#2a292f",
        "panel.background": "#1b1b21",
        "scrollbar.thumb.background": "#46464f",
        "scrollbar.thumb.hover_background": "#918f9a",
        "scrollbar.track.background": "#131318",
        "scrollbar.track.border": "#46464f",
        "editor.background": "#131318",
        "editor.gutter.background": "#131318",
        "editor.subheader.background": "#1f1f25",
        "editor.active_line.background": "#1f1f25",
        "editor.highlighted_line.background": "#1f1f25",
        "editor.line_number": "#46464f",
        "editor.active_line_number": "#c0c1ff",
        "editor.invisible": "#46464f",
        "editor.wrap_guide": "#46464f",
        "editor.active_wrap_guide": "#918f9a",
        "terminal.background": "#131318",
        "terminal.foreground": "#e4e1e9",
        "terminal.bright_foreground": "#e4e1e9",
        "terminal.dim_foreground": "#c7c5d0",
        "syntax": {
          "comment": { "color": "#918f9a", "font_style": "italic" },
          "keyword": { "color": "#e8b9d4", "font_style": "normal" },
          "function": { "color": "#c0c1ff", "font_style": "normal" },
          "string": { "color": "#c5c4dd", "font_style": "normal" },
          "type": { "color": "#e8b9d4", "font_style": "normal" },
          "number": { "color": "#c5c4dd", "font_style": "normal" },
          "property": { "color": "#e4e1e9", "font_style": "normal" },
          "operator": { "color": "#c7c5d0", "font_style": "normal" },
          "variable": { "color": "#e4e1e9", "font_style": "normal" },
          "constant": { "color": "#e8b9d4", "font_style": "normal" }
        }
      }
    }
