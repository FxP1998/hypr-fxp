Dotfiles/.config/pipewire/

# Printer configuration
Dotfiles/.config/cups/

# Network manager connections (may contain passwords)
Dotfiles/.config/NetworkManager/
Dotfiles/.config/systemd/

# Bluetooth pairings
Dotfiles/.config/bluetooth/

# SSH keys (should NEVER be committed)
Dotfiles/.ssh/
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts

# GPG keys
Dotfiles/.gnupg/

# Password managers
Dotfiles/.config/KeePass/
