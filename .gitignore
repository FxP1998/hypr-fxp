Dotfiles/.password-store/

# --- Application State & Cache ---

# Shell history
.bash_history
.zsh_history
.fish_history

# Terminal state
.dotfiles/.local/state/
.dotfiles/.cache/

# Package manager caches
Dotfiles/.cache/pacman/
Dotfiles/.cache/yay/
Dotfiles/.cache/paru/

# Development/build caches
Dotfiles/.cache/cargo/
Dotfiles/.cache/npm/
Dotfiles/.cache/yarn/
Dotfiles/.cache/pip/
Dotfiles/.cache/go-build/
Dotfiles/.cache/maven/
Dotfiles/.cache/gradle/

# Rust/Cargo
Dotfiles/.cargo/

# Node.js
node_modules/
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
ENV/

# Java
*.class
*.jar
*.war
*.ear
target/
build/

# Go
bin/
pkg/

# --- Desktop Environment Specific ---

# Wallpapers (usually large binary files)
Dotfiles/.config/hypr/assets/current-wallpaper.png
Dotfiles/.wallpapers/
Dotfiles/Pictures/Wallpapers/

# Recent documents
.recently-used.xbel
Dotfiles/.local/share/recently-used.xbel

# Trash
.trash/
.local/share/Trash/

# --- Application-Specific (Keep configs, ignore data) ---

# Zsh (keep .zshrc, ignore compdump)
.zcompdump*
.zlogin
.zlogout

# Fish (keep config.fish, ignore history)
Dotfiles/.config/fish/fish_variables

# Mako (notification daemon) - keep config, ignore state
Dotfiles/.config/mako/history

# Waybar (keep config, ignore cache)
Dotfiles/.config/waybar/.waybar.cache

# Rofi (keep config, ignore cache)
Dotfiles/.config/rofi/rofi.runtime

# Dunst (notification daemon)
Dotfiles/.config/dunst/dunstrc  # Keep if template, ignore if machine-specific

# Kitty terminal (keep config, ignore scrollback)
Dotfiles/.config/kitty/scrollback*

# Alacritty (keep config, ignore IPC sockets)
alacritty.ipc

# Wezterm (keep config, ignore state)
Dotfiles/.config/wezterm/wezterm.lua  # Keep
Dotfiles/.config/wezterm/*.log        # Ignore

# Zed editor (keep themes, ignore cache)
Dotfiles/.config/zed/db
Dotfiles/.config/zed/logs
Dotfiles/.config/zed/state.json
# BUT KEEP: Dotfiles/.config/zed/themes/ (for custom themes)

# NeoVim (keep init.vim/init.lua, ignore swap/pack/plugin)
Dotfiles/.config/nvim/swap/
Dotfiles/.config/nvim/undo/
Dotfiles/.config/nvim/backup/
Dotfiles/.config/nvim/view/
Dotfiles/.config/nvim/lazy-lock.json
Dotfiles/.config/nvim/plugin/

# Btop (keep config, ignore history)
Dotfiles/.config/btop/btop.log
Dotfiles/.config/btop/error.log

# Starship (keep config, ignore cache)
Dotfiles/.config/starship/cache/

# --- Files That SHOULD Be Committed ---
# Explicitly keep important configs (uncomment if needed)
#!Dotfiles/.config/alacritty/alacritty.toml
#!Dotfiles/.config/hypr/hyprland.conf
#!Dotfiles/.config/waybar/style.css
#!Dotfiles/.config/waybar/config
#!Dotfiles/.bashrc
#!Dotfiles/.zshrc
#!Dotfiles/.config/nvim/init.lua

# --- Local Machine Files ---
# Files that contain machine-specific paths, IPs, or hostnames
*local*
*host-specific*
machine.conf
local.conf
secrets.conf
credentials*
*password*
*token*
*secret*

# --- Large/Binary Files ---
# Generally avoid binaries in dotfiles
*.pdf
*.epub
*.mobi
*.mp3
*.mp4
*.avi
*.mkv
*.iso
*.img
*.zip
*.tar.gz
*.rar
*.7z
