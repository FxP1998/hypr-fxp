# -----------------------------------------------------------------------------
#  󰣇  FxP1998 REPOSITORY CONFIGURATION
#  󰀻  File: .gitignore
#  󰁔  Description: Core exclusion rules for surgical repository management.
#
#  󰄬  Created By: M. H. IMAM (FxP1998)
#  󰊤  GitHub: https://github.com/FxP1998/
# -----------------------------------------------------------------------------

# --- 1. SYSTEM & EDITOR JUNK ---
*.swp
*.swo
*~
*.bak
*.backup
*.old
.tmp
*.tmp
temp/
.DS_Store
Thumbs.db

# --- 2. FXP1998 PROJECT SPECIFIC ---
.dot-manager.conf
dot-manager.log
.FxP1998_backups/
installed_packages.txt

# --- 3. DOTFILES EXCLUSIONS (Machine-Specific Data) ---

# VS Code / Code OSS
dotfiles/.config/Code*/
!dotfiles/.config/Code/User/settings.json
!dotfiles/.config/Code/User/keybindings.json

# Web Browsers (Never commit profiles/cache)
dotfiles/.config/chromium/
dotfiles/.config/google-chrome/
dotfiles/.config/BraveSoftware/
dotfiles/.config/microsoft-edge/
dotfiles/.config/librewolf/
dotfiles/.config/mozilla/
dotfiles/.thunderbird/

# Media Player State
dotfiles/.config/vlc/
dotfiles/.config/mpv/watch_later/
dotfiles/.config/mpv/state*
dotfiles/.config/kew/

# System Services State
dotfiles/.config/dconf/
dotfiles/.config/pulse/
dotfiles/.config/pipewire/
dotfiles/.config/cups/
dotfiles/.config/NetworkManager/
dotfiles/.config/systemd/
dotfiles/.config/bluetooth/

# Desktop Assets (Temporary)
dotfiles/.config/hypr/assets/current-wallpaper.png
/tmp/album_art.png

# Messaging Apps
dotfiles/.config/discord/
dotfiles/.config/Slack/
dotfiles/.config/Element/
dotfiles/.config/telegram-desktop/

# --- 4. SENSITIVE DATA (CRITICAL) ---
dotfiles/.ssh/
dotfiles/.gnupg/
*.pem
*.key
*.pub
known_hosts
*credentials*
*token*
*secret*
*password*
.env
.netrc

# --- 5. SHELL & TERMINAL STATE ---
.bash_history
.zsh_history
.fish_history
.zcompdump*
.zlogin
.zlogout
dotfiles/.local/state/
dotfiles/.cache/

# --- 6. DEVELOPMENT CACHES ---
dotfiles/.cache/pacman/
dotfiles/.cache/yay/
dotfiles/.cache/paru/
dotfiles/.cache/cargo/
dotfiles/.cache/npm/
dotfiles/.cache/yarn/
dotfiles/.cache/pip/
node_modules/
package-lock.json
__pycache__/
*.py[cod]
.venv/
venv/
target/
build/
bin/
pkg/

# --- 7. APP-SPECIFIC CACHE ---
dotfiles/.config/waybar/.waybar.cache
dotfiles/.config/rofi/rofi.runtime
dotfiles/.config/kitty/scrollback*
dotfiles/.config/zed/db
dotfiles/.config/zed/logs
dotfiles/.config/zed/state.json
dotfiles/.config/nvim/lazy-lock.json

# --- 8. LARGE BINARIES ---
*.mp3
*.mp4
*.mkv
*.avi
*.iso
*.img
*.zip
*.tar.gz
*.7z
*.rar
