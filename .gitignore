# ============================================
# DOTFILES GITIGNORE
# ============================================

# --- Core Principle ---
# Ignore: Machine-specific files, caches, logs, temporary files
# Include: Configuration templates, scripts, themes

# --- System & Editor Junk ---
# Swap/backup files
*.swp
*.swo
*~
*.bak
*.backup
*.old

# Temporary files
.tmp
*.tmp
temp/

# --- Dot Manager ---
dot-manager.log
.dot-manager.conf
.dotfiles-backup/

# --- Application Cache & Data ---

# VS Code / Code OSS
Dotfiles/.config/Code - OSS/CachedData/
Dotfiles/.config/Code - OSS/Cache/
Dotfiles/.config/Code - OSS/GPUCache/
Dotfiles/.config/Code - OSS/DIPS*
Dotfiles/.config/Code - OSS/Dawn*
Dotfiles/.config/Code - OSS/Network Persistent State
Dotfiles/.config/Code - OSS/SharedStorage*
Dotfiles/.config/Code - OSS/Code Cache/
Dotfiles/.config/Code - OSS/crashpad_completed_requests
Dotfiles/.config/Code - OSS/Crash Reports/
Dotfiles/.config/Code - OSS/logs/
Dotfiles/.config/Code - OSS/User/globalStorage/
Dotfiles/.config/Code - OSS/User/workspaceStorage/
Dotfiles/.config/Code - OSS/User/History/
Dotfiles/.config/Code - OSS/User/sync/
Dotfiles/.config/Code - OSS/User/state.vscdb
Dotfiles/.config/Code - OSS/User/Backups/
Dotfiles/.config/Code - OSS/settings.json  # Only if you want machine-specific settings

# Web Browsers
Dotfiles/.config/chromium/
Dotfiles/.config/google-chrome/
Dotfiles/.config/BraveSoftware/
Dotfiles/.config/microsoft-edge/
Dotfiles/.config/librewolf/

# Firefox/Thunderbird
Dotfiles/.config/mozilla/
Dotfiles/.thunderbird/

# Media Players
Dotfiles/.config/vlc/
Dotfiles/.config/mpv/watch_later/
Dotfiles/.config/mpv/state*
Dotfiles/.config/kew/

# Messaging Apps
Dotfiles/.config/discord/
Dotfiles/.config/Slack/
Dotfiles/.config/Element/
Dotfiles/.config/telegram-desktop/

# Email Clients
Dotfiles/.config/evolution/
Dotfiles/.config/kmail2/

# --- System Configuration (Machine-Specific) ---

# DConf databases (GNOME/GTK settings)
Dotfiles/.config/dconf/

# PulseAudio/pipewire audio state
Dotfiles/.config/pulse/
